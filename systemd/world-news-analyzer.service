[Unit]
Description=World News Article Analyzer Service (Pi4 LLM Worker)
After=network.target world-news-api.service

[Service]
Type=simple
WorkingDirectory=%h/world_news
Environment="PYTHONPATH=%h/world_news/src"
ExecStart=%h/world_news/venv/bin/python -m world_news.analyzer
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
