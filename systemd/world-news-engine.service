[Unit]
Description=World News Event Engine Service (Pi4 Expiration & Merge Engine)
After=network-online.target world-news-api.service world-news-analyzer.service world-news-geocoder.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hidakamasato/world_news
ExecStart=/home/hidakamasato/world_news/venv/bin/python -m world_news.engine
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/hidakamasato/world_news/src

[Install]
WantedBy=default.target
